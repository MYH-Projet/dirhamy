// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum TypeCompte {
  Cash
  Banque
}

enum TypeTransaction {
  DEPENSE
  REVENU
  TRANSFER
}

model Utilisateur {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  nom          String
  prenom       String
  email        String  @unique
  motDePasse   String
  refreshToken String?

  // Relationships
  comptes    Compte[]
  categories Categorie[]
  weeklySummaries WeeklySummary[]
  conversations Conversation[]
}

model Compte {
  id   String     @id @default(auto()) @map("_id") @db.ObjectId
  nom  String
  type TypeCompte

  // Foreign Key
  utilisateurId String      @db.ObjectId
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])

  // Relationships
  transactionsSent     Transaction[] @relation("SourceAccount")
  transactionsReceived Transaction[] @relation("DestinationAccount")

  snapshots BalanceSnapshot[]
}

model Categorie {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  nom   String
  limit Float?

  // Foreign Key
  utilisateurId String      @db.ObjectId
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])

  // Relationships
  transactions Transaction[]
  snapshots    BudgetSnapshot[]

  @@unique([utilisateurId, nom])
}

model BudgetSnapshot {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  monthDate DateTime // Store as 1st of the month (e.g., 2025-12-01T00:00:00Z)
  limit     Float // The budget set for this month
  spend     Float    @default(0) // The calculated total spent (Cached)

  categorieId String    @db.ObjectId
  categorie   Categorie @relation(fields: [categorieId], references: [id])

  // Ensure unique snapshot per category per month
  @@unique([categorieId, monthDate])
}

model Transfer {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  createdAt    DateTime      @default(now())
  // This relation links to the transactions
  transactions Transaction[]
}

model Transaction {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  montant     Float
  type        TypeTransaction
  date        DateTime        @default(now())
  description String

  // Foreign Keys
  compteId String @db.ObjectId
  compte   Compte @relation("SourceAccount", fields: [compteId], references: [id])

  idDestination String?  @db.ObjectId
  destination   Compte?  @relation("DestinationAccount", fields: [idDestination], references: [id])

  transferId String?   @db.ObjectId
  transfer   Transfer? @relation(fields: [transferId], references: [id])

  categorieId String    @db.ObjectId
  categorie   Categorie @relation(fields: [categorieId], references: [id])

  @@index([compteId, date, id, montant])
}

model BalanceSnapshot {
  id    String   @id @default(auto()) @map("_id") @db.ObjectId
  date  DateTime // The date this "save point" was made
  solde Float // The calculated balance at that exact moment

  compteId String @db.ObjectId
  compte   Compte @relation(fields: [compteId], references: [id])

  @@index([compteId, date]) // Important for finding the "latest" snapshot quickly
}


//weejly summary for the Embeddings

model WeeklySummary {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  weekStart   DateTime  // Start of the week (e.g., Monday 00:00)
  weekEnd     DateTime  // End of the week (e.g., Sunday 23:59)
  summary     String    // Text summary of user behavior
  embedding   Float[]   // Gemini text-embedding-004 produces 768 dims (in-app cosine search)
  createdAt   DateTime  @default(now())
  // Foreign Key
  utilisateurId String      @db.ObjectId
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])
  @@unique([utilisateurId, weekStart])
  @@index([utilisateurId])
}

// Conversation groups chat messages together
model Conversation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String   @default("New Chat")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  utilisateurId String      @db.ObjectId
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])

  messages ChatMessage[]

  @@index([utilisateurId, updatedAt])
}

// Chat message within a conversation
model ChatMessage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  content   String
  sender    String   // "user" or "ai"
  createdAt DateTime @default(now())

  conversationId String       @db.ObjectId
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
